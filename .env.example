# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database & Security Configuration (PostgreSQL)
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="zero_leak"
DB_USER="postgres"
DB_PASSWORD="your_password_here"
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/zero_leak"
DATABASE_USERNAME="postgres"
JWT_SECRET="zeroleak_secure_jwt_secret_key_2026_super_encrypted"
EMAIL_HOST="smtp.zeroleak-edu.org"
EMAIL_USERNAME="verification@zeroleak-edu.org"
EMAIL_PASSWORD="email_credential_placeholder"
ENCRYPTION_CONFIGURATION="AES-256-GCM"
RSA_KEY_CONFIGURATION="RSA-2048-PKCS1"
AI_MODEL_CONFIGURATION="gemini-3.7-flash"

# Local question-paper extraction engine
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:latest"
OLLAMA_API_KEY="your_ollama_api_key_or_token"

# Cloudinary document storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Groq Cloud Ultra-Fast Free AI Engine (GPT-OSS 120B / 20B)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

