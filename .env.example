# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database & Security Configuration (PostgreSQL)
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="zero_leak"
DB_USER="postgres"
DB_PASSWORD="your_password_here"
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/zero_leak"
DATABASE_USERNAME="postgres"
JWT_SECRET="your_jwt_secret_here"
EMAIL_HOST="smtp.zeroleak-edu.org"
EMAIL_USERNAME="verification@zeroleak-edu.org"
EMAIL_PASSWORD="email_credential_placeholder"
ENCRYPTION_CONFIGURATION="AES-256-GCM"
RSA_KEY_CONFIGURATION="RSA-2048-PKCS1"
AI_MODEL_CONFIGURATION="gemini-3.7-flash"

# Local question-paper extraction engine (FREE & UNLIMITED — no API key, no quota)
# Ollama is the floor of the AI chain: the app keeps working with zero cloud keys.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5vl:7b"
# Smaller text model for interactive chat and per-question answering. Generation speed is
# bounded by model size, so the 4B is faster than the 7B above and a full generation
# newer than the qwen2.5:3b it replaced, answering more accurately. The 7B stays for
# extraction, where reading a whole paper correctly matters more than latency.
# Pull it first:  ollama pull qwen3.5:4b   (leave blank to use OLLAMA_MODEL for everything)
OLLAMA_FAST_MODEL="qwen3.5:4b"
# Local embeddings for semantic duplicate detection. One-time: ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL="nomic-embed-text"
# Context window to load the model with. Ollama's own default is 4096 tokens regardless of
# what the model supports, and it silently DISCARDS the overflow rather than failing — so a
# long paper reaches the model truncated and it answers confidently from a partial document.
# 16384 holds the largest prompt this app sends (~10k tokens). Higher = more RAM, slower.
OLLAMA_NUM_CTX="16384"
# Per-request ceiling for local inference. It has no quota but runs on CPU, where prompt
# processing measured ~24 tokens/sec — a full-size paper is ~9,600 tokens, so ~400s before
# any output. 15 min covers that worst case; smaller papers finish much sooner.
OLLAMA_TIMEOUT_MS="900000"
# Output-token ceiling per reply — bounds a runaway generation, which on CPU is an
# unbounded wait. 4096 covers a full extracted question list or a LaTeX document.
# Set 0 to let the model decide for itself.
OLLAMA_NUM_PREDICT="4096"
# Thinking models (qwen3.x, gemma4...) stream their reasoning into a separate field that
# this app never displays, while those tokens still count against OLLAMA_NUM_PREDICT — a
# long trace can leave the visible answer empty after minutes of CPU wait. Replies here are
# short and factual, so reasoning is off by default. Set true to keep it on.
OLLAMA_THINK="false"
# Only needed if your Ollama is behind an authenticated proxy.
OLLAMA_API_KEY=""

# Cloudinary document storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ---------------------------------------------------------------------------
# Free AI providers — permanent free tiers, no credit card, no trial.
# ALL ARE OPTIONAL. Requests walk this chain in order and fall through on rate
# limits or quota exhaustion, ending at local Ollama, which never runs out.
# Leave any key blank to skip that provider.
# ---------------------------------------------------------------------------

# 0. NVIDIA NIM API (https://build.nvidia.com) — Fast enterprise inference endpoints
NVIDIA_API_KEY=""
NVIDIA_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# 0b. AgentRouter gateway (Anthropic Messages API shape) — OFF by default.
#    WARNING: this gateway rejects non-Claude-Code clients with
#    "401 unauthorized client detected". Enabling it makes this server send a spoofed
#    'claude-cli' User-Agent, which likely violates their ToS, can get the account
#    suspended, and routes your question papers through a third party. See the note on
#    invokeAnthropic() in server/aiProviders.ts. Leave the key empty to keep it disabled.
AGENTROUTER_BASE_URL="https://agentrouter.org"
AGENTROUTER_API_KEY=""
AGENTROUTER_MODEL="deepseek-v4-flash"

# 1. Groq — 30 RPM / 1K RPD / 200K TPD. Fastest option. https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# 2. Google Gemini — ~15 RPM / ~1500 RPD. The only free tier with native PDF input,
#    which is what makes scanned-paper extraction work. https://aistudio.google.com/apikey
#    Note: free-tier prompts may be used for training; not available in EU/EEA/UK/CH.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"

# 3. Cerebras — 1M tokens/day claimed. Verify the current tier when you sign up;
#    some 2026 reports say the no-card tier was replaced by a $5 signup credit.
#    https://cloud.cerebras.ai
CEREBRAS_API_KEY=""
CEREBRAS_MODEL="gpt-oss-120b"

# 4. Mistral — ~1 req/s, 1B tokens/month. Most generous monthly cap. Phone verification.
#    https://console.mistral.ai/api-keys
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"

# 5. OpenRouter — ~20 RPM / 50 RPD on ':free' models. https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# 6. GitHub Models — 10-15 RPM / 50-150 RPD with a GitHub account.
#    https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=""
GITHUB_MODELS_MODEL="gpt-4o-mini"

# Optional: override the failover order, e.g. "groq,gemini,ollama".
# Ollama is always appended last regardless of this value.
AI_PROVIDER_ORDER=""

# Free LaTeX.Online Cloud Compiler Engine (Open source, no API key required)
LATEX_ONLINE_BASE_URL="https://latexonline.cc"

# Self-hosted LaTeX compile service (latex-service/) - no quota, no API key.
# Start with: docker compose -f latex-service/docker-compose.yml up -d
LATEX_SERVICE_URL="http://127.0.0.1:3013"

# FormaTeX Cloud LaTeX & AI Compilation Engine
FORMATEX_API_KEY="fex_your_formatex_api_key_here"
FORMATEX_BASE_URL="https://api.formatex.io/api/v1"

# TexAPI Cloud LaTeX Compiler (https://texapi.ovh)
# Auth uses the X-API-KEY header (not Bearer). Generate a key at
# https://texapi.ovh/dashboard/apikey - it is shown only once.
# Rate limit: 20 req/min; a compile costs 2 requests. Artefacts expire in 10 min.
TEXAPI_API_KEY="your_texapi_key_here"
TEXAPI_BASE_URL="https://texapi.ovh"



